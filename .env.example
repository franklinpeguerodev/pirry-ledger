# Pirry Ledger - variables de entorno de desarrollo local.
#
# Copia este archivo y rellena tus valores (no lo hagas si ya tienes un .env):
#     if (-not (Test-Path .env)) { Copy-Item .env.example .env }
#
# .env esta en .gitignore: nunca se sube al repositorio (RD-10) y cada quien
# tiene el suyo. Este .env.example si se versiona y no lleva valores reales.
#
# La API busca el .env desde el directorio desde el que la lanzas hacia arriba y
# lo carga antes de leer la configuracion. Lo que ya este definido en la terminal
# o en el sistema NO lo pisa el archivo: el entorno real manda.
#
# Si un valor tiene espacios o el caracter #, ponlo entre comillas dobles.

# --- Obligatorias -------------------------------------------------------------
# Cadena de conexion a PostgreSQL. Si falta, la aplicacion no arranca.
ConnectionStrings__PirryLedger=Host=127.0.0.1;Port=5432;Database=pirry_ledger;Username=<usuario>;Password=<contrasena>
# Direccion publica de la aplicacion: fija el puerto donde escucha la API y la
# direccion con la que se arman los enlaces de activacion.
PIRRY_LEDGER_PUBLIC_BASE_URL=http://localhost:5243

# --- Primer Administrador (opcional) ------------------------------------------
# Sin estas dos no se crea ningun Administrador. Ver el README, seccion
# "El primer Administrador".
PIRRY_LEDGER_FIRST_ADMIN_EMAIL=<correo-del-administrador>
PIRRY_LEDGER_FIRST_ADMIN_PASSWORD=<contrasena-del-administrador>
PIRRY_LEDGER_FIRST_ADMIN_NAME=Administrador

# --- Correo saliente (opcional) -----------------------------------------------
# Sin estas seis la aplicacion y el registro funcionan igual, pero el enviador
# de correos no puede entregar nada. Ver el README, paso "SMTP real con Gmail".
PIRRY_LEDGER_SMTP_HOST=smtp.gmail.com
PIRRY_LEDGER_SMTP_PORT=587
PIRRY_LEDGER_SMTP_SECURITY=StartTls
PIRRY_LEDGER_SMTP_USER=<tu-cuenta-de-prueba@gmail.com>
PIRRY_LEDGER_SMTP_PASSWORD=<contrasena-de-aplicacion>
PIRRY_LEDGER_SMTP_FROM=<tu-cuenta-de-prueba@gmail.com>

# --- Almacenamiento de imagenes (obligatorio) ----------------------------------
# Las siete variables son obligatorias: si falta una, la aplicacion NO
# arranca y dice el nombre de la que falta. Ver el README, seccion
# "Imagenes del catalogo".
#
# El bucket es PRIVADO: el unico acceso a los objetos es con una firma que
# genera el servidor. El token de API de R2 debe estar limitado a este bucket
# y solo a los objetos.
PIRRY_LEDGER_R2_ACCOUNT_ID=<identificador-de-la-cuenta-de-cloudflare>
PIRRY_LEDGER_R2_ACCESS_KEY_ID=<clave-de-acceso-del-token-de-r2>
PIRRY_LEDGER_R2_SECRET_ACCESS_KEY=<secreto-del-token-de-r2>
PIRRY_LEDGER_R2_BUCKET=<nombre-del-bucket>
PIRRY_LEDGER_R2_ENDPOINT=https://<identificador-de-la-cuenta>.r2.cloudflarestorage.com

# Minutos que dura la firma de descarga. La maxima de SigV4 es de siete dias,
# pero una ventana corta reduce eluso de una URL filtrada.
PIRRY_LEDGER_IMAGE_SIGNATURE_MINUTES=15

# Bytes maximos de una imagen. El valor por defecto esta pensado para una
# foto de 1920x1080 en JPEG, WebP o PNG razonable.
PIRRY_LEDGER_IMAGE_MAX_BYTES=5242880
