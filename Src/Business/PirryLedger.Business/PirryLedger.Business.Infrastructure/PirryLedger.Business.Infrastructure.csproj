         construccion es internal: en produccion el unico camino es el
         constructor del adaptador. -->
    <InternalsVisibleTo Include="PirryLedger.Business.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PirryLedger.Business.Application\PirryLedger.Business.Application.csproj" />
    <ProjectReference Include="..\PirryLedger.Business.Domain\PirryLedger.Business.Domain.csproj" />
    <ProjectReference Include="..\..\..\Core\PirryLedger.Core.Contracts\PirryLedger.Core.Contracts.csproj" />
  </ItemGroup>

