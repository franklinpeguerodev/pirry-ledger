<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Src\Core\PirryLedger.Core.AccessControl\PirryLedger.Core.AccessControl.Domain\PirryLedger.Core.AccessControl.Domain.csproj" />
    <ProjectReference Include="..\..\Src\Core\PirryLedger.Core.AccessControl\PirryLedger.Core.AccessControl.Application\PirryLedger.Core.AccessControl.Application.csproj" />
    <!-- Infrastructure aporta el Argon2id real. Probar con un hasher de mentira
         no diria nada del hash senuelo, que es justamente lo que hay que
         comprobar en RF-CA-03. -->
    <ProjectReference Include="..\..\Src\Core\PirryLedger.Core.AccessControl\PirryLedger.Core.AccessControl.Infrastructure\PirryLedger.Core.AccessControl.Infrastructure.csproj" />
    <!-- La capa Api, para que la prueba de RF-CA-05 pueda enumerar las rutas REALES
         que registra MapAccessControl en vez de escribir una lista a mano. -->
    <ProjectReference Include="..\..\Src\Core\PirryLedger.Core.AccessControl\PirryLedger.Core.AccessControl.Api\PirryLedger.Core.AccessControl.Api.csproj" />
    <!-- Los casos de uso de Permissions que la prueba de RF-CA-05 enumera
         para confirmar que las nuevas rutas del modulo (Create, List,
         Approve, Reject) declaran su Operation en RoleRequirements. -->
    <ProjectReference Include="..\..\Src\Core\PirryLedger.Core.Permissions\PirryLedger.Core.Permissions.Application\PirryLedger.Core.Permissions.Application.csproj" />
    <!-- MapPermissions se llama desde RutasReales para incluir las nuevas
         rutas en la enumeracion que valida RF-CA-05. -->
    <ProjectReference Include="..\..\Src\Core\PirryLedger.Core.Permissions\PirryLedger.Core.Permissions.Api\PirryLedger.Core.Permissions.Api.csproj" />
    <!-- MapBusiness se llama desde RutasReales para que las rutas del negocio
         tambien tengan que declarar su Operation (RF-NEG-06). -->
    <ProjectReference Include="..\..\Src\Business\PirryLedger.Business\PirryLedger.Business.Api\PirryLedger.Business.Api.csproj" />
  </ItemGroup>

  <!-- MapAccessControl devuelve IEndpointRouteBuilder, asi que la prueba necesita el
       framework de ASP.NET para poder construir la aplicacion y leer sus rutas. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>